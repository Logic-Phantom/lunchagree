# 공유 방(Supabase Free). 비워 두면 '한 기기 모드'(방장 폰 하나로 돌려 입력)로 동작한다.
# anon key만 넣는다. service_role 키는 절대 넣지 않는다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# 음식점 격자 타일(GitHub Pages, data-build 산출물 out/) 기준 주소. 비워 두면 후보는 '직접 추가'만 가능.
VITE_PLACES_BASE_URL=
# (선택) 브이월드 배경지도 키. 비워 두면 '내 주변 지도'는 거리 링만 그린다. 키 발급 시 서비스 URL(토스 미니앱 도메인) 등록 필요.
VITE_VWORLD_KEY=
